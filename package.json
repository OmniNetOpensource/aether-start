    "@tanstack/solid-router-devtools": "2.0.0-beta.24",
    "@tanstack/solid-start": "2.0.0-beta.30",
    "@tiptap/core": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
