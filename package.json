{
  "name": "aether-start",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host :: --port 3100",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "auth:generate": "better-auth generate --config src/backend/auth/identity/auth.ts --output src/backend/auth/identity/auth.schema.ts --yes",
    "auth:migration:generate": "drizzle-kit generate --dialect sqlite --driver d1-http --schema src/backend/auth/identity/auth.schema.ts --out migrations --name better_auth",
    "cf:typegen": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types",
    "cf:migrate:local": "wrangler d1 migrations apply DB --local",
    "cf:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "cf:deploy": "vite build && node scripts/patch-wrangler-config.mjs && wrangler deploy --env production",
    "cf:sync-secrets": "node scripts/sync-env-to-cloudflare.mjs",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "type-check": "tsc --noEmit",
    "check": "pnpm type-check && pnpm lint && pnpm format:check && pnpm build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
